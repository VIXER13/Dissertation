Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"interpolate", "[", 
    RowBox[{
    "data_", ",", "\[CapitalPhi]_", ",", "R1_", ",", "R2_", ",", "number_"}], 
    "]"}], ":=", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"tmp", "=", 
       RowBox[{"Interpolation", "[", 
        RowBox[{
         RowBox[{"data", "\[LeftDoubleBracket]", 
          RowBox[{
           RowBox[{"2", ";;", "All"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "2", ",", "number"}], "}"}]}], 
          "\[RightDoubleBracket]"}], ",", 
         RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"tmp", " ", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"tmp", "[", 
            RowBox[{
             RowBox[{"R1", " ", 
              RowBox[{"Cos", "[", 
               RowBox[{"\[CapitalPhi]", "[", "x", "]"}], "]"}]}], ",", 
             RowBox[{"R2", " ", 
              RowBox[{"Sin", "[", 
               RowBox[{"\[CapitalPhi]", "[", "x", "]"}], "]"}]}]}], "]"}]}], 
          "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "0", ",", "1", ",", "0.01"}], "}"}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Interpolation", "[", 
        RowBox[{"tmp", ",", 
         RowBox[{"InterpolationOrder", "\[Rule]", "1"}]}], "]"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"Interpolation", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{
            RowBox[{"ResourceFunction", "[", "\"\<Loess\>\"", "]"}], "[", 
            RowBox[{"tmp", ",", "20", ",", "x"}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "0", ",", "1", ",", "0.001"}], "}"}]}], "]"}], 
       "]"}]}], "\[IndentingNewLine]", "}"}], "\[LeftDoubleBracket]", "1", 
    "\[RightDoubleBracket]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.926430244696307*^9, 3.926430270711927*^9}, {
  3.9264303014159*^9, 3.926430305855831*^9}, {3.926430841777594*^9, 

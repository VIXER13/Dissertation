   RowBox[{"data_", ",", "\[CapitalPhi]_", ",", "R1_", ",", "R2_"}], "]"}], ":=", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tmp", "=", 
     RowBox[{"Interpolation", "[", 

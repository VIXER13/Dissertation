Cell[BoxData[{
 RowBox[{
  RowBox[{"x", "=", 
   FractionBox["\[Rho]", 
    RadicalBox[
     RowBox[{"1", "+", 
      SuperscriptBox[
       RowBox[{"Tan", "[", "\[CurlyPhi]", "]"}], "n"]}], "n"]]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"y", "=", 

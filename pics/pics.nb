 RowBox[{
  RowBox[{"CS", "=", "0.1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"quadratures", "[", "poly_", "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"p", "=", "poly"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"centroid", "=", 
       RowBox[{"RegionCentroid", "[", "p", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"coords", "=", 

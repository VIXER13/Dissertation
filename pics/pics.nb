       RowBox[{"Tan", "[", "\[CurlyPhi]", "]"}], "n"]}], "n"]]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"jac", "=", 
  RowBox[{"Det", "[", GridBox[{
     {
      RowBox[{
       SubscriptBox["\[PartialD]", "\[Rho]"], "x"}], 
      RowBox[{
       SubscriptBox["\[PartialD]", "\[Rho]"], "y"}]},
     {
      RowBox[{
       SubscriptBox["\[PartialD]", "\[CurlyPhi]"], "x"}], 
      RowBox[{
       SubscriptBox["\[PartialD]", "\[CurlyPhi]"], "y"}]}
    }], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"A", "=", 
   FractionBox[
    RowBox[{
     SuperscriptBox["4", 
      FractionBox["1", "n"]], "n", " ", "p", " ", 
     SuperscriptBox["q", 
      FractionBox["2", "p"]]}], 
    RowBox[{"8", 
     RowBox[{"Beta", "[", 
      RowBox[{
       FractionBox["1", "2"], ",", 
       FractionBox["1", "n"]}], "]"}], 
     RowBox[{"Gamma", "[", 
      FractionBox["2", "p"], "]"}]}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Assuming", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"r", ">", "0"}], "&&", 
    RowBox[{"p", ">", "0"}], "&&", 
    RowBox[{"q", ">", "0"}], "&&", 
    RowBox[{"n", ">", "0"}], "&&", 
    RowBox[{"\[Sigma]", ">", "0"}]}], ",", 
   RowBox[{
    UnderoverscriptBox["\[Integral]", "0", 
     FractionBox["\[Pi]", "2"]], 
    RowBox[{
     UnderoverscriptBox["\[Integral]", "0", "\[Sigma]"], 
     RowBox[{"A", " ", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "q"}], " ", 
        SuperscriptBox["\[Rho]", "p"]}], "]"}], "jac", 
      RowBox[{"\[DifferentialD]", "\[Rho]"}], 
      RowBox[{"\[DifferentialD]", "\[CurlyPhi]"}]}]}]}]}], "]"}]}], "Input",
